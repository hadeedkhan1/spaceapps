SUPABASE_URL=
SUPABASE_KEY=
SERPAPI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-9b

# LoopMessage (Send to Earth). Without LOOP_API_KEY and LOOP_TO, sending runs in mock mode.
# LOOP_TO is the Earth-side phone number that receives the health report, in international format.
# LOOP_SENDER_ID is the sender ID from the LoopMessage dashboard.
LOOP_API_KEY=
LOOP_TO=
LOOP_SENDER_ID=
# Legacy accounts only:
# LOOP_SECRET_KEY=
# LOOP_API_URL=https://server.loopmessage.com/api/v1/message/send/
